# TRUST-GEO Environment Variables Template
# Copy this file to .env for local configuration

# LLM Provider Configuration (Optional - system works in deterministic demo mode when unset)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Audit Storage
DATABASE_PATH=trust_geo_audit.db

# Verification Thresholds
TEMPORAL_FRESHNESS_HOURS=72
