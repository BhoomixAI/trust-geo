# TRUST-GEO environment variables. Copy to .env (git-ignored) and fill in.

# AI under test: set ONE of these keys. Groq has a free tier (console.groq.com).
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# TRUST_GEO_AI_PROVIDER=groq            # or anthropic; default: whichever key is set
# TRUST_GEO_AI_MODEL=openai/gpt-oss-120b

# Audit database path (default: data/trust_geo.db, git-ignored)
# TRUST_GEO_DB=data/trust_geo.db
